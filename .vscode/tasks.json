{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Java",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "javac \"%file%\" && java \"%~n1\" < input.txt > output.txt"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$javac"
        }
    ]
}