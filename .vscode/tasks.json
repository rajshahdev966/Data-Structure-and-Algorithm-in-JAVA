{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Java",
            "type": "shell",
            "command": "javac",
            "args": [
                "${file}",
                "&&",
                "java",
                "${fileBasenameNoExtension}",
                "<",
                "input.txt",
                ">",
                "output.txt"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe"
                }
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$javac"
        }
    ]
}