{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run Java",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "javac \"${file}\" && java \"${fileBasenameNoExtension}\" < input.txt > output.txt"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        }
    ]
}