{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Java",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "javac \"${file}\" && java \"${fileBasenameNoExtension}\" < input.txt > output.txt"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$javac",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}